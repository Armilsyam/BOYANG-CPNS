# 1. App URL (Local: http://localhost:3000 | Production: https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# 2. Better Auth Secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-at-least-32-character-random-secret

# 3. Neon Postgres (Auto-provisioned via: vercel integration add neon && vercel env pull .env.local --yes)
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 4. Midtrans Core API QRIS (Rp 10.000)
# Sandbox keys: https://dashboard.sandbox.midtrans.com/settings/config_info
# Production keys: https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# 5. Akun Khusus Admin (Terpisah dari Akun Peserta) & WhatsApp Resmi BOYANG-CPNS
